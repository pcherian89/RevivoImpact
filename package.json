{
  "name": "revivo-impact-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "Revivo Impact prototype on fictional data (P1 clickable shell).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check:copy": "node tools/check-copy.mjs",
    "shots": "node tools/screenshots.mjs",
    "test": "vitest run",
    "test:roles": "node tests/e2e/roles.mjs",
    "test:journeys": "node tests/e2e/journeys.mjs",
    "test:guide": "node tests/e2e/guide.mjs",
    "test:a11y": "node tests/e2e/a11y.mjs",
    "check": "npm run typecheck && npm test && npm run check:copy && npm run build && npm run test:journeys && npm run test:guide && npm run test:roles && npm run test:a11y && npm run check:plain",
    "check:plain": "node tools/check-plain.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "lucide-react": "^1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "^4.14.1",
    "tailwindcss": "4.3.4",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^5.1.1"
  }
}
